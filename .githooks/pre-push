#!/bin/sh
# Every install that auto-updates takes what reaches main, so nothing reaches it unchecked.
# Run it by hand too: .githooks/pre-push
set -e
cd "$(git rev-parse --show-toplevel)"
remote=${1:-origin}
claude plugin validate .
# The remote's main before this push; none on a first push.
base=$(git rev-parse -q --verify "$remote/main" || true)
for mod in plugins/*/; do
  mod=${mod%/}
  claude plugin validate "$mod"
  claude plugin test "$mod"
  # tsc needs the types the engine lays in .claude-plugin/types once a session has loaded the folder.
  if [ -d "$mod/.claude-plugin/types" ]; then tsc -p "$mod"; fi
  # An installed copy takes a change only when its version goes up, so a changed mod needs a new one.
  # ponytail: any changed file counts, a README fix included; leave docs out here if the bumps get tiresome.
  if [ -n "$base" ] && ! git diff --quiet "$base" HEAD -- "$mod"; then
    was=$(git show "$base:$mod/.claude-plugin/plugin.json" 2>/dev/null | jq -r .version)
    now=$(git show "HEAD:$mod/.claude-plugin/plugin.json" | jq -r .version)
    if [ "$was" = "$now" ]; then
      echo "$mod changed since $remote/main, but its version is still $now: raise it in $mod/.claude-plugin/plugin.json." >&2
      exit 1
    fi
  fi
done
